<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="6dp"/>
            <solid android:color="#17000000"/>
            <stroke android:width="1dp" android:color="#18000000"/>
        </shape>
    </item>
    <item android:gravity="top" android:height="6dp">
        <shape>
            <corners android:topLeftRadius="6dp" android:topRightRadius="6dp"/>
            <gradient android:angle="270" android:startColor="#35000000" android:endColor="#00000000"/>
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape>
            <corners android:bottomLeftRadius="6dp" android:bottomRightRadius="6dp"/>
            <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#17FFFFFF"/>
        </shape>
    </item>
</layer-list>