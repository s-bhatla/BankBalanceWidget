<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_tile" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/tile">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/card_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="12sp" android:includeFontPadding="false"
            android:ellipsize="end" android:maxLines="1"/>
        <ImageButton android:id="@+id/card_refresh" android:layout_width="36dp" android:layout_height="24dp"
            android:padding="1dp" android:src="@drawable/refresh" android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/refresh_widget"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/card_header_rule" android:layout_width="match_parent"
        android:layout_height="1dp" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/card_balance_label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/card_outstanding_label"
        android:textSize="12sp" android:layout_marginTop="8dp" android:includeFontPadding="false"/>
    <LinearLayout android:id="@+id/card_amount_area" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/card_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:scaleType="centerInside" android:adjustViewBounds="true" android:importantForAccessibility="yes"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/card_statement_area" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/card_bill_area" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/card_bill_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/card_bill_label" android:textSize="11sp" android:includeFontPadding="false"/>
            <ImageView android:id="@+id/card_bill_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:scaleType="centerInside" android:adjustViewBounds="true"
                android:importantForAccessibility="yes"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/card_bill_rule" android:layout_width="1dp" android:layout_height="match_parent"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/card_date_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/card_due_label" android:textSize="11sp" android:includeFontPadding="false"/>
            <TextView android:id="@+id/card_due" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textSize="13sp" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/card_source" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>